# Working defaults for the container stack. No credentials or editing required.
#   docker compose up --build -d
# Copy this file to .env only when you want to change something.
COMPOSE_PROJECT_NAME=loadpilot
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=5173
BACKEND_PORT=8000
MODEL_PORT=9000
MODEL_ARTIFACTS_DIR=./model/artifacts
BACKEND_HISTORY_DIR=./backend/data
MODEL_BUNDLE_NAME=freight-rpm-v1
MODEL_RANGE_NAME=historical-range-v1.json
MODEL_EXPECTED_VERSION=freight-rpm-v1

# ---------------------------------------------------------------------------
# Board connection
# ---------------------------------------------------------------------------
# Empty runs LoadPilot offline against the bundled demo dataset: every screen
# works, but accepting or bidding is disabled because there is no board.
# Point this at a compatible load board (scheme + host + port) for live ingest.
EXTERNAL_API_URL=
BOARD_WEBSOCKET_ENABLED=true
BOARD_SYNC_INTERVAL_SECONDS=30
SIMULATION_CLOCK_SYNC_INTERVAL_SECONDS=1.0
# The bundled demo fleet is a frozen capture, so its freshness window is wide.
# With a live board set this back to 120 seconds.
MAX_FLEET_SNAPSHOT_AGE_SECONDS=315360000
LOG_LIVE_ORDERS_VERBOSE=false

# ---------------------------------------------------------------------------
# Historical dataset
# ---------------------------------------------------------------------------
# Imported once on first start. The bundled file is a captured sample.
HISTORY_CSV_PATH=/history/historical_shipments.csv
HISTORICAL_MIN_SAMPLES=5
HISTORICAL_LOOKBACK_DAYS=365
HISTORICAL_ORIGIN_RADIUS_MILES=100

# ---------------------------------------------------------------------------
# Dispatch policy
# ---------------------------------------------------------------------------
MAX_PICKUP_MOVE_MILES=100
MIN_EXPECTED_MARGIN_PCT=15
MIN_EXPECTED_MARGIN_USD=0
MAX_DEADHEAD_MILES=100
MIN_PICKUP_LEAD_MINUTES=0
PICKUP_BUFFER_MINUTES=0
ASSUMED_TRAVEL_SPEED_MPH=45
ENFORCE_MARGIN=true
TURNAROUND_MINUTES=30
RANK_EMPTY_MILES_WEIGHT=0.60
RANK_CONTINUITY_WEIGHT=0.25
RANK_UTILIZATION_WEIGHT=0.15
RANK_UTILIZATION_HORIZON_HOURS=24
RANK_PROFIT_WEIGHT=0.40
RANK_PROFIT_TARGET_PER_HOUR=100
OPPORTUNITY_COST_ENABLED=true
OPPORTUNITY_COST_PER_HOUR=25
POSITIONING_VALUE_ENABLED=true
POSITIONING_CREDIT_FRACTION=0.25
POSITIONING_MAX_CREDIT=500

# ---------------------------------------------------------------------------
# Pricing model
# ---------------------------------------------------------------------------
MODEL_API_TIMEOUT_SECONDS=10
MODEL_MAX_REFERENCE_DEVIATION_PCT=25
MODEL_MONITORING_BUNDLE=/artifacts/models/freight-rpm-v1
MONITORING_MIN_RECORDS=1
MONITORING_MAX_ERROR_RATE=0.5
MONITORING_MAX_INVALID_FEATURE_RATE=0.5
MONITORING_MAX_UNSEEN_LANE_RATE=1

# ---------------------------------------------------------------------------
# Autopilot safety
# ---------------------------------------------------------------------------
# Two independent gates: the backend will not book unless BOTH sets allow it.
# The defaults are off. Never enable live booking against real freight.
AUTOPILOT_LIVE_ENABLED=false
AUTOPILOT_KILL_SWITCH=true
MODEL_AUTOPILOT_LIVE_TOKEN=
LOADPILOT_AUTOPILOT_LIVE_ENABLED=false
LOADPILOT_AUTOPILOT_KILL_SWITCH=true
LOADPILOT_AUTOPILOT_LIVE_TOKEN=
LOADPILOT_AUTOPILOT_ORDER_TYPES=open_bid,fixed_rate
LOADPILOT_AUTOPILOT_CLOCK_MODE=simulation
LOADPILOT_PRICING_FALLBACK_MODE=review
LOADPILOT_PRICING_UNSEEN_CATEGORY_ACTION=review
LOADPILOT_PRICING_MODEL_BLOCKED=false
